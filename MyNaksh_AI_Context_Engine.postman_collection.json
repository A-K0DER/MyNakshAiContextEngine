    {
      "name": "4-5. Failure & Degraded Confidence",
      "item": [
        {
          "name": "Repeat request (observe random ~10% partial failure)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"user_101\",\n  \"question\": \"career guidance\"\n}" },
            "url": { "raw": "{{baseUrl}}/personalize", "host": ["{{baseUrl}}"], "path": ["personalize"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Run this request multiple times (Postman Runner, 15-20 iterations).",
                  "// Watch server stdout for upstream_fetch log lines with status:'failed'.",
                  "// The corresponding response here will show confidence MEDIUM or LOW.",
                  "pm.test('response has confidence field', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(['HIGH','MEDIUM','LOW']).to.include(json.confidence);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Full outage (500) - requires temporarily raising maybeFail rate, see API_TESTING.md #5",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"user_101\",\n  \"question\": \"career guidance\"\n}" },
            "url": { "raw": "{{baseUrl}}/personalize", "host": ["{{baseUrl}}"], "path": ["personalize"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Caching",
      "item": [
        {
          "name": "Cache warm-up call (1st, slower)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"cache_test_user\",\n  \"question\": \"career guidance\"\n}" },
            "url": { "raw": "{{baseUrl}}/debug/personalization", "host": ["{{baseUrl}}"], "path": ["debug", "personalization"] }
          },
          "response": []
        },
        {
          "name": "Cache hit call (2nd, much faster)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"cache_test_user\",\n  \"question\": \"career guidance\"\n}" },
            "url": { "raw": "{{baseUrl}}/debug/personalization", "host": ["{{baseUrl}}"], "path": ["debug", "personalization"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('second call is fast (cache hit)', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Validation & Error Handling",
      "item": [
        {
          "name": "Missing userId -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"hi\"\n}" },
            "url": { "raw": "{{baseUrl}}/personalize", "host": ["{{baseUrl}}"], "path": ["personalize"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 400', function () { pm.response.to.have.status(400); });"] }
