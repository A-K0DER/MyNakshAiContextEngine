PORT=3000

# LLM provider selection: "mock" (default, no key needed), "anthropic", or "gemini"
LLM_PROVIDER=mock

# Only required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only required if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cache TTLs in milliseconds
USER_CACHE_TTL_MS=300000
KUNDLI_CACHE_TTL_MS=300000
HOROSCOPE_CACHE_TTL_MS=60000
PANCHANG_CACHE_TTL_MS=3600000
